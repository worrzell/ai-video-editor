# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://localhost:5432/ai_video_editor

# Initial Admin Credentials
AUTH_DEFAULT_USER=admin
AUTH_DEFAULT_PASS=change_this_password_in_production
AUTH_JWT_SECRET=generate_a_random_32_byte_secret_here
AUTH_TOKEN_EXPIRE_HOURS=72

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
